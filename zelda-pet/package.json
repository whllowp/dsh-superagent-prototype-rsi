{
  "name": "dsh-zelda-pet",
  "version": "0.1.0",
  "private": true,
  "description": "A Zelda-inspired desktop companion for the DeepSeek Harness web panel: a little forest sprite who wanders, naps at night, and cheers your sessions on. Zero configuration.",
  "type": "module",
  "main": "lib/host.js",
  "types": "lib/host.d.ts",
  "exports": { ".": "./lib/host.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown"
  },
  "engines": { "dsh": "^0.2.1-alpha.2" },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "@types/react": "18.3.28"
  },
  "files": ["lib", "cordis.patch.yml", "README.md"]
}
